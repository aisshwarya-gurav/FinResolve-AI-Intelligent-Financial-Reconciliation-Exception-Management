# Pick ONE provider by uncommenting its section below.
# Set LLM_PROVIDER to match, then fill in that provider's key.

LLM_PROVIDER=gemini

# --- Gemini (recommended: genuinely free tier, no card required) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.5-flash   # optional override, this is the default

# --- OpenRouter (routes to many models, some free, one API key) ---
# Get a free key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Anthropic (if you do have a Claude API key) ---
# ANTHROPIC_API_KEY=your_key_here

# --- Razorpay ---
# Leave RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET unset to run in mock mode
# (safe default — used for tests, demos, and development without live
# credentials). Set both to enable live Razorpay API calls.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

JWT_SECRET_KEY=
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=

